{
  "name": "menacesearch-pro",
  "version": "0.0.2",
  "description": "OSINT инструмент с Telegram-авторизацией и HWID",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.menacesearch.pro",
    "productName": "MenaceSEARCH Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.html",
      "main.js",
      "preload.js",
      "auth-preload.js",
      "telegram.config.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  }
}